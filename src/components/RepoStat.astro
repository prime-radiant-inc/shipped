---
// RepoStat.astro — renders ONE repo's generated stat chip row for a given
// week, from src/data/weekly-stats.json (see tools/gen_stats.py). All
// numbers come from that file — nothing here is hardcoded.
//
// NOTE ON USAGE: as of this writing, none of the 8 existing weekly posts
// (src/content/posts/week-*.md) have a separate, isolated per-repo "stat
// line" to drop this into — every per-repo number is woven directly into
// hand-written prose sentences. This component exists, is correct, and is
// verified (see the delegate reports), ready for any post that wants a
// discrete stat chip instead of/alongside narrative prose.
import weeklyStats from '../data/weekly-stats.json';

interface Props {
  org: string;
  name: string;
  week: number;
}

const { org, name, week } = Astro.props;
const weekKey = `week-${week}`;
const weekData = weeklyStats[weekKey];
if (!weekData) {
  throw new Error(`RepoStat: no stats for ${weekKey} in src/data/weekly-stats.json`);
}
const repoKey = `${org}/${name}`;
const r = weekData.repos[repoKey];
if (!r) {
  throw new Error(`RepoStat: no stats for ${repoKey} in ${weekKey}`);
}

function fmt(n: number) {
  return n.toLocaleString('en-US');
}

const authorTitle = r.authors.map((a: { name: string; count: number }) => `${a.name} (${a.count})`).join(', ');

const hasDiff = r.loc_added > 0 || r.loc_removed > 0;
const diffTotal = r.loc_added + r.loc_removed;
// GitHub-style proportional split; if removed is ~0 this naturally comes
// out as 100% green. Guard div-by-zero for the (hasDiff-gated) render.
const addPct = diffTotal > 0 ? (r.loc_added / diffTotal) * 100 : 100;
const delPct = diffTotal > 0 ? (r.loc_removed / diffTotal) * 100 : 0;

const releaseTitle = r.tagged_releases.map((rel: { tag: string; name: string }) => rel.name || rel.tag).join(', ');
const releaseLabel =
  r.tagged_releases.length === 1
    ? r.tagged_releases[0].tag
    : `${r.tagged_releases.length} releases`;
---

<span class="repo-stat">
  <span class="repo-stat-chip repo-stat-commits" title={authorTitle || undefined}>
    {fmt(r.commits)} commit{r.commits === 1 ? '' : 's'}
  </span>
  {r.merged_prs.length > 0 && (
    <span class="repo-stat-chip repo-stat-prs">
      {r.merged_prs.length} PR{r.merged_prs.length === 1 ? '' : 's'}
    </span>
  )}
  {r.tagged_releases.length > 0 && (
    <span class="repo-stat-chip repo-stat-release" title={releaseTitle}>
      🏷 {releaseLabel}
    </span>
  )}
  {hasDiff && (
    <span class="repo-stat-diff" title={`+${fmt(r.loc_added)} / −${fmt(r.loc_removed)} lines`}>
      <span class="repo-stat-diff-add">+{fmt(r.loc_added)}</span>
      <span class="repo-stat-diff-del">−{fmt(r.loc_removed)}</span>
      <span class="repo-stat-diff-bar">
        <span class="repo-stat-diff-bar-add" style={`width: ${addPct}%`}></span>
        <span class="repo-stat-diff-bar-del" style={`width: ${delPct}%`}></span>
      </span>
    </span>
  )}
</span>
