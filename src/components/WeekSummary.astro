---
// WeekSummary.astro — renders the week's stats block from
// src/data/weekly-stats.json (generated by tools/gen_stats.py from
// data/recon-v2-8wk-20260814-CORRECTED.json). No number here is
// hand-typed; regenerate the data file, not this markup, when the
// underlying repo activity changes.
//
// `week` is the ISO week-START DATE (e.g. "2026-06-22"), NOT an ordinal
// index — weeks are date-anchored throughout this codebase so backfilling
// an older week later is a drop-in, never a renumbering. Pass the exact
// string key as it appears in src/data/weekly-stats.json.
//
// Markup below is an exact match of the original hand-typed <ul
// class="stats"> block it replaces — same classes, same wording, same
// U+2212 minus sign (not a hyphen) in the LOC line — so existing CSS
// styling is unaffected.
import weeklyStats from '../data/weekly-stats.json';

interface Props {
  week: string; // ISO date, e.g. "2026-06-22"
}

const { week } = Astro.props;
const data = weeklyStats[week];
if (!data) {
  throw new Error(`WeekSummary: no stats for week "${week}" in src/data/weekly-stats.json`);
}
const s = data.summary;

// Belt-and-suspenders guard: this component only READS the pre-aggregated
// s.loc_added/s.loc_removed -- it does not sum per-repo cells itself (that
// happens once, in tools/gen_stats.py, when weekly-stats.json is
// generated/regenerated). That is exactly how the site-wide leak happened:
// RepoStat.astro correctly hides the +/- LOC chip for any cell flagged
// loc_suppressed (a data-dump / vendored / generated-artifact / revert-of-
// revert cell), but this shared "week in numbers" total kept summing those
// suppressed cells' raw LOC anyway, on every week that had one.
//
// Since WeekSummary is the ONE place every week's headline number renders,
// re-derive the correct total from data.repos here too and hard-fail the
// build if it ever disagrees with the stored summary -- so a future
// regen that forgets to exclude a loc_suppressed cell breaks the build
// instead of silently shipping a leaked number.
const repos = Object.values(data.repos) as { loc_added: number; loc_removed: number; loc_suppressed?: boolean }[];
const expectedLocAdded = repos.reduce((sum, r) => sum + (r.loc_suppressed ? 0 : r.loc_added), 0);
const expectedLocRemoved = repos.reduce((sum, r) => sum + (r.loc_suppressed ? 0 : r.loc_removed), 0);
if (expectedLocAdded !== s.loc_added || expectedLocRemoved !== s.loc_removed) {
  throw new Error(
    `WeekSummary: stored summary LOC for week "${week}" (+${s.loc_added}/-${s.loc_removed}) ` +
      `does not match the sum of non-suppressed repo cells (+${expectedLocAdded}/-${expectedLocRemoved}). ` +
      `Re-run: python3 tools/gen_stats.py --recompute-summaries src/data/weekly-stats.json`
  );
}

function fmt(n: number) {
  return n.toLocaleString('en-US');
}
---

<h2>The week in numbers</h2>

<ul class="stats">
<li><strong>{fmt(s.repos_active)}</strong> repos active ({s.featured_count} featured, {s.second_tier_count} also shipped)</li>
<li><strong>{fmt(s.commits)}</strong> commits</li>
<li><strong>{fmt(s.merged_prs)}</strong> merged PRs</li>
<li><strong>+{fmt(s.loc_added)} / −{fmt(s.loc_removed)}</strong> lines</li>
<li><strong>{fmt(s.contributors)}</strong> contributors</li>
<li><strong>{fmt(s.tagged_releases)}</strong> tagged releases</li>
</ul>
